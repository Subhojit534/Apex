{
  "name": "@apex/desktop",
  "version": "0.1.0",
  "description": "APEX Desktop Assistant (NOVA) built with Electron, React and Vite",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:vercel": "node scripts/build-vercel.js",
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "start": "electron .",
    "clean": "rm -rf dist dist-electron"
  },
  "dependencies": {
    "@apex/incident-core": "workspace:*",
    "@apex/server": "workspace:*",
    "@apex/shared": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.1.0"
  }
}
