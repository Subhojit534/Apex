# APEX Server Environment Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Gemini API Configuration (server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# Vercel Integration Configuration (optional, can also be connected in the UI)
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Supabase Configuration (Google Authentication & Cross-Device Sync)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client Connection URLs (defaults used if omitted)
VITE_SERVER_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws

